# SMC Analyzer Backend — Environment Variables
# Copy this to .env and fill in your values

# MongoDB connection string (required)
MONGODB_URI=mongodb://localhost:27017/smc-analyzer

# Server port (optional, defaults to 4000)
PORT=4000

# CORS allowed origin for the frontend (optional, defaults to http://localhost:3000)
FRONTEND_ORIGIN=http://localhost:3000

# Binance API (optional — used for rate-limit headers)
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# Cache TTL in seconds for market data (optional, default 30)
MARKET_DATA_CACHE_TTL=30

# Cache TTL in seconds for news events (optional, default 300)
NEWS_CACHE_TTL=300
